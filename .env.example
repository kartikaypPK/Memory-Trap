# Copy to .env and fill in from your Supabase project (Settings > API).
# Only the public URL and anon/publishable key ever go in the app.
# NEVER put the service-role key, an ElevenLabs key, or any secret here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Sign-In (Phase 1): the *Web* OAuth client ID from Google Cloud
# Console. The same ID must be set on the Google provider in the Supabase
# dashboard (Authentication > Providers > Google). Leave empty until those
# clients exist — the app shows "Google Sign-In not configured yet" and
# email OTP / guest mode keep working.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
